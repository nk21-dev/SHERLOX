# ----------------------------------------------------
# SHERLOX ENVIRONMENT VARIABLES
# ----------------------------------------------------

# Application Base URL (http://localhost:3000 locally, https://sherlox-black.vercel.app in production)
APP_URL=http://localhost:3000

# Production Database (PostgreSQL on Neon / Supabase / Vercel Postgres)
# Leave empty for local development (uses local SQLite automatically)
DATABASE_URL=

# Resend Transactional Email (for password reset dispatches)
RESEND_API_KEY=
EMAIL_FROM=
